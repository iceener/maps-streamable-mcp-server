# Bun server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP identity and fetch-native endpoint
MCP_NAME="Google Maps"
MCP_TITLE="Google Maps"
MCP_VERSION=1.0.0
MCP_INSTRUCTIONS="Use these tools to search places, get details, and plan routes."
MCP_PUBLIC_URL=http://localhost:3000/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
MCP_LEGACY_MODE=stateless
MCP_MAX_REQUEST_BYTES=1048576
MCP_ACCEPT_HEADERS=

# Static MCP caller authentication
AUTH_ENABLED=true
AUTH_STRATEGY=bearer
BEARER_TOKEN=your-random-mcp-access-token
AUTH_REQUIRE_RS=false
AUTH_ALLOW_DIRECT_BEARER=false

# Server-side Google Maps provider credential; never derived from BEARER_TOKEN
API_KEY=your-google-maps-api-key
API_KEY_HEADER=x-api-key

# Existing operational settings retained by the migration
RPS_LIMIT=10
CONCURRENCY_LIMIT=5
RS_TOKENS_FILE=.data/tokens.json
RS_TOKENS_ENC_KEY=
