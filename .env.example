# Local settings for `bun run dev`. Copy to .env.
# Workers read wrangler.jsonc in development (and .dev.vars, if you create one), and
# wrangler.production.jsonc in production.

# development | production | test
NODE_ENV=development
# debug | info | warning | error
LOG_LEVEL=info

# Where Bun listens.
HOST=127.0.0.1
PORT=3000

# Public URL of the MCP endpoint, written canonically.
# Defaults to http://127.0.0.1:$PORT/mcp outside production; required in production.
# MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp

# Hostnames accepted in Host and Origin headers: lowercase, no scheme, no port.
# Default: the public URL's hostname, plus localhost, 127.0.0.1 and [::1] outside production.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGIN_HOSTNAMES=mcp.example.com

# stateless: also serve 2025-era clients. reject: 2026-07-28 clients only.
# MCP_LEGACY_MODE=stateless
# Largest request body in bytes. Production uses 1048576. Default: the SDK's 4 MiB.
# MCP_MAX_REQUEST_BYTES=1048576

# none | bearer | oauth. Required in production, which uses bearer.
AUTH_MODE=none

# AUTH_MODE=bearer: every client sends this token as `Authorization: Bearer <token>`.
# Generate one with `openssl rand -hex 32`. It must not contain whitespace.
# BEARER_TOKEN=

# Required. Google Maps Platform API key with Places API (New) and Routes API enabled.
# The server sends it to Google only, in the X-Goog-Api-Key header.
API_KEY=

# Tests only: a loopback server that stands in for the Google APIs. Leave it unset.
# GOOGLE_API_ORIGIN=http://127.0.0.1:9999
